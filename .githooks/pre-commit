#!/bin/sh
# Format staged Rust sources with rustfmt before commit.
# Enable once per clone: git config core.hooksPath .githooks
# Or: pnpm run hooks:install
set -e

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found; skipping rustfmt" >&2
  exit 0
fi

staged_rs=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$staged_rs" ]; then
  exit 0
fi

echo "pre-commit: cargo fmt --all"
cargo fmt --all

# Keep the commit contents formatted: re-stage only previously staged .rs files.
echo "$staged_rs" | while IFS= read -r file; do
  [ -n "$file" ] || continue
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done
