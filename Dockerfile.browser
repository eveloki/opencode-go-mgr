# syntax=docker/dockerfile:1.7

FROM rust:1.88.0-bookworm AS builder

ARG CARGO_REGISTRY=sparse+https://index.crates.io/
WORKDIR /src
ENV CARGO_REGISTRIES_CRATES_IO_INDEX=$CARGO_REGISTRY \
    CARGO_HTTP_MULTIPLEXING=false \
    CARGO_HTTP_TIMEOUT=600 \
    CARGO_NET_RETRY=10
RUN if [ "$CARGO_REGISTRY" != "sparse+https://index.crates.io/" ]; then \
      printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' \
        "$CARGO_REGISTRY" > /usr/local/cargo/config.toml; \
    fi
COPY . .
RUN --mount=type=cache,id=ocg-cargo-registry-browser,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ocg-cargo-target-browser,target=/src/target \
    cargo build --locked --release -p ocg-browser-worker \
    && cp /src/target/release/ocg-browser-worker /ocg-browser-worker

FROM debian:bookworm-slim

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      ca-certificates \
      chromium \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      openbox \
      tini \
      websockify \
      x11vnc \
      xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ocg \
    && useradd --uid 10001 --gid 10001 --create-home \
      --home-dir /home/ocg --shell /usr/sbin/nologin ocg \
    && install -d -m 0700 -o ocg -g ocg /profiles /run/ocg-browser \
    && install -d -m 0755 -o ocg -g ocg /opt/ocg-browser

COPY --from=builder /ocg-browser-worker /usr/local/bin/ocg-browser-worker
COPY browser/entrypoint.sh /usr/local/bin/ocg-browser-entrypoint
COPY LICENSE /usr/share/licenses/ocg-browser-worker/LICENSE

ENV DISPLAY=:99 \
    HOME=/home/ocg \
    OCG_BROWSER_CONTROL_ADDR=0.0.0.0:9080 \
    OCG_BROWSER_CONTROL_TOKEN_FILE=/run/ocg-browser/control-token \
    OCG_BROWSER_PROFILE_ROOT=/profiles \
    OCG_BROWSER_BINARY=/usr/bin/chromium \
    OCG_BROWSER_DISPLAY=:99 \
    OCG_BROWSER_VNC_WS_URL=ws://browser:6080/websockify

USER ocg
VOLUME ["/profiles", "/run/ocg-browser"]
EXPOSE 9080 6080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9080/health', timeout=3).read()"]

ENTRYPOINT ["/usr/bin/tini", "--", "/bin/sh", "/usr/local/bin/ocg-browser-entrypoint"]
