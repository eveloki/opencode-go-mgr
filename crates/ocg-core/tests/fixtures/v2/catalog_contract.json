{
  "comment": "Black-box Plan catalog contract for OCG Manager v2.0. GET /dashboard/api/providers/catalog is the only Plan source. Internal identity stays provider_id + offering_id. Catalog JSON uses display_name/display_family, creation_availability, verification_policy, verification_runtime_availability, routable, form_fields, risk_notice, model_aliases, pricing_availability, and usage_availability. risk_notice is omitted when a Plan has none.",
  "catalog_paths": [
    "/dashboard/api/providers/catalog",
    "/dashboard/api/providers"
  ],
  "required_entry_fields": [
    "provider_id",
    "offering_id",
    "display_name",
    "display_family",
    "creation_availability",
    "verification_policy",
    "verification_runtime_availability",
    "routable",
    "form_fields",
    "model_aliases",
    "pricing_availability",
    "usage_availability"
  ],
  "risk_notice_fields": ["acknowledgement_id", "version", "content_hash"],
  "custom_create": {
    "custom_config_fields": ["base_url", "upstream_protocol", "auth_scheme"],
    "model_capability_fields": ["model_id", "protocol"]
  },
  "plans": [
    {
      "provider_id": "opencode",
      "offering_id": "go",
      "verification_policy": "not_required",
      "verification_runtime_availability": "optional",
      "creation_availability": "available",
      "routable": true,
      "required_aliases": ["deepseek-v4-flash", "minimax-m2.7", "grok-4.5"]
    },
    {
      "provider_id": "opencode-zen-free",
      "offering_id": "anonymous-free",
      "verification_policy": "not_required",
      "verification_runtime_availability": "not_applicable",
      "creation_availability": "unavailable",
      "routable": true,
      "singleton": true,
      "required_aliases": ["mimo-v2.5-free", "mimo-v2.5"]
    },
    {
      "provider_id": "command-code",
      "offering_id": "goat",
      "verification_policy": "required",
      "verification_runtime_availability": "unavailable",
      "creation_availability": "available",
      "routable": false,
      "model_aliases_empty": true
    },
    {
      "provider_id": "scnet",
      "offering_id": "token-plan-basic",
      "verification_policy": "required",
      "verification_runtime_availability": "unavailable",
      "creation_availability": "available",
      "routable": false,
      "requires_risk_notice": true,
      "key_prefix": "sk-tp-",
      "model_aliases_empty": true,
      "required_form_field_ids": ["acknowledgement"]
    },
    {
